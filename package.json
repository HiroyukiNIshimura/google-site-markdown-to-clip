{
  "name": "google-site-markdown-to-clip",
  "displayName": "Google Sites Markdown to Clipboard",
  "description": "Copy Markdown from VS Code in Google Sites markdown script format",
  "version": "0.0.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/HiroyukiNIshimura/google-site-markdown-to-clip.git"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.138.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "google-site-markdown-to-clip.copy",
        "title": "Copy as Google Sites Markdown"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "google-site-markdown-to-clip.copy",
          "when": "editorLangId == markdown",
          "group": "navigation@5"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.138.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}